    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "eslint": "9.39.5",
    "globals": "16.0.0",
    "html-validate": "9.7.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0"
  }
}
